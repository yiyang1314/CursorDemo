<Window x:Class="CursorWpf.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="CursorWpf" Width="1540" Height="960" MinWidth="1120" MinHeight="700"
 WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <Style x:Key="ChromeButton" TargetType="Button"><Setter Property="Width" Value="46"/><Setter Property="Height" Value="34"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="MenuButton" TargetType="Button"><Setter Property="Padding" Value="10,5"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="RailButton" TargetType="Button"><Setter Property="Height" Value="46"/><Setter Property="Width" Value="48"/><Setter Property="Margin" Value="0,2"/><Setter Property="FontSize" Value="18"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7" Margin="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource SelectedBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ToolButton" TargetType="Button"><Setter Property="Padding" Value="9,6"/><Setter Property="Margin" Value="2"/><Setter Property="Background" Value="{DynamicResource ControlBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBrush}"/><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource EditorBrush}"/><Setter Property="Foreground" Value="{DynamicResource EditorTextBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="7,6"/><Setter Property="Margin" Value="1,1,2,1"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectedBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="25"/></Grid.RowDefinitions>
  <!-- custom title bar -->
  <Border Grid.Row="0" Background="{DynamicResource TitleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"><Border Width="19" Height="19" CornerRadius="5" Background="{DynamicResource AccentBrush}" Margin="0,0,8,0"><TextBlock Text="C" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Border><TextBlock Text="CursorWpf" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
     <Button Style="{StaticResource MenuButton}" Content="文件(F)" Click="FileMenu_Click"/><Button Style="{StaticResource MenuButton}" Content="编辑(E)" Click="EditMenu_Click"/><Button Style="{StaticResource MenuButton}" Content="查看(V)" Click="ViewMenu_Click"/><Button Style="{StaticResource MenuButton}" Content="帮助(H)" Click="HelpMenu_Click"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Style="{StaticResource ChromeButton}" Content="—" Click="Minimize_Click"/><Button Style="{StaticResource ChromeButton}" Content="□" Click="Maximize_Click"/><Button Style="{StaticResource ChromeButton}" Content="×" Click="Close_Click"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="218"/><ColumnDefinition Width="5"/><ColumnDefinition Width="0.95*" MinWidth="360"/><ColumnDefinition Width="5"/><ColumnDefinition Width="1.2*" MinWidth="460"/></Grid.ColumnDefinitions>
   <!-- activity rail -->
   <Border Grid.Column="0" Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"><DockPanel LastChildFill="True"><StackPanel DockPanel.Dock="Top" Margin="0,8,0,0"><Button Style="{StaticResource RailButton}" Content="＋" ToolTip="新建任务"/><Button Style="{StaticResource RailButton}" Content="▣" ToolTip="资源管理器"/><Button Style="{StaticResource RailButton}" Content="⌕" ToolTip="搜索"/><Button Style="{StaticResource RailButton}" Content="◇" ToolTip="插件市场"/><Button Style="{StaticResource RailButton}" Content="◷" ToolTip="自动化"/><Button Style="{StaticResource RailButton}" Content="▦" ToolTip="模板库"/></StackPanel><Button DockPanel.Dock="Bottom" Style="{StaticResource RailButton}" Content="⚙" ToolTip="设置" Margin="0,0,0,8"/></DockPanel></Border>
   <!-- explorer -->
   <Border Grid.Column="1" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="10,8"><DockPanel>
    <StackPanel DockPanel.Dock="Top"><Grid Margin="2,2,2,12"><TextBlock Text="资源管理器" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="···" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/></Grid><TextBlock Text="项目" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="3,0,0,7"/><Button Style="{StaticResource ToolButton}" Content="＋  打开文件夹" Command="{Binding OpenFolderCommand}" HorizontalContentAlignment="Left" Margin="0,0,0,8"/></StackPanel>
    <ListBox ItemsSource="{Binding ProjectItems}" SelectedItem="{Binding SelectedProjectItem}"/>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"><TextBlock Text="外观" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="3,0,0,4"/><UniformGrid Columns="2"><Button Style="{StaticResource ToolButton}" Content="深色" Command="{Binding DarkCommand}"/><Button Style="{StaticResource ToolButton}" Content="浅色" Command="{Binding LightCommand}"/></UniformGrid><TextBlock Text="语言 / Language" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="3,8,0,4"/><UniformGrid Columns="2"><Button Style="{StaticResource ToolButton}" Content="中文" Command="{Binding ChineseCommand}"/><Button Style="{StaticResource ToolButton}" Content="English" Command="{Binding EnglishCommand}"/><Button Style="{StaticResource ToolButton}" Content="帮助文档" Command="{Binding HelpCommand}" Grid.ColumnSpan="2"/></UniformGrid>
     <Button Click="UserProfile_Click" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8" Margin="0,12,0,0"><StackPanel Orientation="Horizontal"><Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentBrush}"><TextBlock Text="U" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="本地用户" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="免费账户 · 设置个人资料" FontSize="9" Foreground="{DynamicResource MutedBrush}"/></StackPanel></StackPanel></Button>
    </StackPanel>
   </DockPanel></Border>
   <GridSplitter Grid.Column="2" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource SplitterBrush}"/>
   <!-- AI chat -->
   <Border Grid.Column="3" Background="{DynamicResource ChatBrush}" Padding="12,10"><DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,0,10"><DockPanel><TextBlock Text="✦  AI CHAT" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="本地工作区" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="10,1,0,0"/></DockPanel></Border>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding InputText,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="100" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}" VerticalContentAlignment="Center"/><Button Grid.Column="1" Content="↑" Width="38" Height="36" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" FontSize="18" FontWeight="Bold" Command="{Binding SendCommand}"/></Grid></Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Messages}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource MessageBrush}" CornerRadius="10" Padding="12" Margin="0,5,0,7" MaxWidth="720" HorizontalAlignment="Left"><StackPanel><TextBlock Text="{Binding Role}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,0,0,5"/><TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" FontSize="12" LineHeight="19"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   </DockPanel></Border>
   <GridSplitter Grid.Column="4" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource SplitterBrush}"/>
   <!-- editor workspace -->
   <Border Grid.Column="5" Background="{DynamicResource EditorBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"><DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource TitleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal"><Border Background="{DynamicResource EditorBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,2,0,0" Padding="12,9"><TextBlock Text="{Binding CurrentFile}" FontSize="11"/></Border><Button Style="{StaticResource MenuButton}" Content="＋" ToolTip="新建标签"/></StackPanel></Border>
    <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" Padding="8,5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><DockPanel><TextBlock Text="{Binding CurrentFile}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" FontSize="10"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Style="{StaticResource ToolButton}" Content="打开" Command="{Binding OpenFileCommand}"/><Button Style="{StaticResource ToolButton}" Content="保存" Command="{Binding SaveCommand}"/><Button Style="{StaticResource ToolButton}" Content="图片预览" Click="ImagePreview_Click"/></StackPanel></DockPanel></Border>
    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="22"/></Grid.RowDefinitions><TextBox Grid.Row="0" Text="{Binding EditorText,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" FontFamily="Cascadia Code,Consolas" FontSize="13" Padding="14" BorderThickness="0" Background="{DynamicResource EditorBrush}" Foreground="{DynamicResource EditorTextBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/><Border Grid.Row="1" Background="{DynamicResource EditorStatusBrush}"><DockPanel Margin="9,0"><TextBlock Text="Ln 1, Col 1" Foreground="{DynamicResource MutedBrush}" FontSize="9"/><TextBlock Text="UTF-8    CRLF    C#" Foreground="{DynamicResource MutedBrush}" FontSize="9" DockPanel.Dock="Right"/></DockPanel></Border></Grid>
   </DockPanel></Border>
  </Grid>
  <Border Grid.Row="2" Background="{DynamicResource StatusBrush}"><DockPanel Margin="10,0"><TextBlock Text="●  Ready" Foreground="White" FontSize="10" VerticalAlignment="Center"/><TextBlock Text="WPF  ·  .NET Framework 4.8  ·  CursorWpf 1.1.0" Foreground="White" FontSize="10" DockPanel.Dock="Right" VerticalAlignment="Center"/></DockPanel></Border>
 </Grid>
</Window>