<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AyuUI.Controll.Controls">

    <local:ShortcutKeyConverter x:Key="ShortcutKeyConverter" />
    <!-- ===================================================================== -->
    <!-- 通用深色分割线样式 (Separator)                                         -->
    <!-- ===================================================================== -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,5" />
        <Setter Property="Background" Value="#32353B" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}" Margin="{TemplateBinding Margin}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== -->
    <!-- 样式一：仿图1 - 现代按键胶囊风菜单 (KeycapDarkMenuStyle)               -->
    <!-- 特点：大圆角面板 + 独立按键方框 [Ctrl] + [Z] + 极简无图标列             -->
    <!-- ===================================================================== -->
    <Style x:Key="KeycapSubMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Foreground" Value="#E2E4E9" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="ItemBd" Background="{TemplateBinding Background}" CornerRadius="6" Margin="4,1" Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="75" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 菜单文本 -->
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="2,0,18,0" />

                            <!-- 快捷键胶囊组 (自动拆分 Ctrl + Z) -->
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding InputGestureText, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ShortcutKeyConverter}}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <!-- 按键方框 -->
                                            <Border x:Name="KeyCap" Background="#25272C" BorderBrush="#3E4149" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="1,0">
                                                <TextBlock Text="{Binding Text}" Foreground="#9CA3AF" FontSize="11.5" FontFamily="Consolas, Segoe UI" />
                                            </Border>
                                            <!-- 加号 -->
                                            <TextBlock x:Name="PlusSign" Text="+" Foreground="#6B7280" FontSize="11" VerticalAlignment="Center" Margin="3,0" Visibility="Collapsed" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsPlus}" Value="True">
                                                <Setter TargetName="KeyCap" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="PlusSign" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 如果有三级子菜单，显示右箭头 -->
                            <Path x:Name="SubArrow" Grid.Column="2" Data="M0,0 L4,4 L0,8" Stroke="#9CA3AF" StrokeThickness="1.3" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed" />

                            <!-- 三级弹出子菜单 -->
                            <Popup x:Name="SubPopup" Placement="Right" HorizontalOffset="4" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#212328" BorderBrush="#343740" BorderThickness="1" CornerRadius="8" Padding="0,4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="4" Color="Black" Opacity="0.45" />
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="SubArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBd" Property="Background" Value="#2F333D" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#5C606A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="KeycapDarkMenuStyle" TargetType="Menu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="#B8BCC4" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="ItemContainerStyle" Value="{StaticResource KeycapSubMenuItemStyle}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="TopBd" Background="Transparent" CornerRadius="5" Padding="10,5" Margin="2,0">
                                    <Grid>
                                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />

                                        <!-- 1. PlacementTarget 显式锚定 TopBd，确保左边缘基准一致 -->
                                        <!-- 2. HorizontalOffset="-8" 抵消 DropShadowEffect 产生的左侧透明阴影留白 -->
                                        <Popup Placement="Bottom"
                                           PlacementTarget="{Binding ElementName=TopBd}"
                                           HorizontalOffset="-4"
                                           VerticalOffset="2"
                                           IsOpen="{TemplateBinding IsSubmenuOpen}"
                                           AllowsTransparency="True"
                                           Focusable="False"
                                           PopupAnimation="Fade">
                                            <!-- 外层留出 8px Margin 给投影渲染，避免阴影被 Popup 裁剪，同时让内层 Border 左边缘精准对齐 TopBd -->
                                            <Border Background="#212328" BorderBrush="#343740" BorderThickness="1" CornerRadius="8" Padding="0,5" Margin="6,2,8,10" MinWidth="170">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="4" Color="Black" Opacity="0.45" />
                                                </Border.Effect>
                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TopBd" Property="Background" Value="#2A2D34" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                    <Trigger Property="IsSubmenuOpen" Value="True">
                                        <Setter TargetName="TopBd" Property="Background" Value="#2A2D34" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== -->
    <!-- 样式二：仿图2 - Visual Studio 经典专业风 (VsDarkMenuStyle)             -->
    <!-- 特点：左侧独立图标列 + 纯文本快捷键右对齐 + 级联展开箭头 + 一级边框高亮 -->
    <!-- ===================================================================== -->
    <Style x:Key="VsSubMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Foreground" Value="#E0E0E0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="ItemBd" Background="{TemplateBinding Background}" CornerRadius="4" Margin="4,1" Padding="6,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- 左侧固定 24px 图标列 -->
                                <ColumnDefinition Width="24" />
                                <!-- 菜单名称列 -->
                                <ColumnDefinition Width="*" MinWidth="120" />
                                <!-- 右侧快捷键列 -->
                                <ColumnDefinition Width="Auto" />
                                <!-- 右侧子菜单箭头列 -->
                                <ColumnDefinition Width="18" />
                            </Grid.ColumnDefinitions>

                            <!-- 图标渲染 (支持 MenuItem.Icon 传入 Path 或 Image) -->
                            <ContentPresenter Grid.Column="0" ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center" Width="15" Height="15" />

                            <!-- 菜单文本 -->
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="4,0,16,0" />

                            <!-- 纯文本快捷键 (如 Ctrl+Shift+S) -->
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="#9E9E9E" FontSize="12" VerticalAlignment="Center" Margin="12,0,4,0" />

                            <!-- 级联展开右箭头 (>) -->
                            <Path x:Name="Arrow" Grid.Column="3" Data="M0,0 L4,4 L0,8" Stroke="#B0B0B0" StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Visibility="Collapsed" />

                            <!-- 多级子菜单弹出框 -->
                            <Popup Placement="Right" HorizontalOffset="2" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="6" Padding="0,4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Color="Black" Opacity="0.45" />
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBd" Property="Background" Value="#37373D" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#656565" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VsDarkMenuStyle" TargetType="Menu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="#D4D4D4" />
                    <Setter Property="FontSize" Value="12.5" />
                    <Setter Property="ItemContainerStyle" Value="{StaticResource VsSubMenuItemStyle}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="TopBd" Background="Transparent" CornerRadius="5" Padding="10,5" Margin="2,0">
                                    <Grid>
                                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />

                                        <!-- 1. PlacementTarget 显式锚定 TopBd，确保左边缘基准一致 -->
                                        <!-- 2. HorizontalOffset="-8" 抵消 DropShadowEffect 产生的左侧透明阴影留白 -->
                                        <Popup Placement="Bottom"
                                           PlacementTarget="{Binding ElementName=TopBd}"
                                           HorizontalOffset="-8"
                                           VerticalOffset="2"
                                           IsOpen="{TemplateBinding IsSubmenuOpen}"
                                           AllowsTransparency="True"
                                           Focusable="False"
                                           PopupAnimation="Fade">
                                            <!-- 外层留出 8px Margin 给投影渲染，避免阴影被 Popup 裁剪，同时让内层 Border 左边缘精准对齐 TopBd -->
                                            <Border Background="#212328" BorderBrush="#343740" BorderThickness="1" CornerRadius="8" Padding="0,5" Margin="8,2,8,10" MinWidth="170">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="4" Color="Black" Opacity="0.45" />
                                                </Border.Effect>
                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TopBd" Property="Background" Value="#2A2D34" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                    <Trigger Property="IsSubmenuOpen" Value="True">
                                        <Setter TargetName="TopBd" Property="Background" Value="#2A2D34" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== -->
    <!-- 自定义状态机指示灯样式 (AyuStateIndicator)                             -->
    <!-- ===================================================================== -->
    <Style TargetType="{x:Type local:AyuStateIndicator}">
        <Setter Property="Foreground" Value="#D1D5DB" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:AyuStateIndicator}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 灯珠容器 -->
                        <Grid Width="{TemplateBinding IndicatorSize}" Height="{TemplateBinding IndicatorSize}" VerticalAlignment="Center">
                            <!-- 外层光晕圈 -->
                            <Ellipse x:Name="GlowRing" Fill="#4B5563" Opacity="0.25" Margin="-3">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="6" />
                                </Ellipse.Effect>
                            </Ellipse>

                            <!-- 核心灯珠主体 -->
                            <Ellipse x:Name="CoreDot" Fill="#6B7280" Stroke="#1F2937" StrokeThickness="1" />

                            <!-- 顶部微高光点（模拟真实 LED 玻璃质感） -->
                            <Ellipse Width="4" Height="2.5" Fill="White" Opacity="0.45" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0" />
                        </Grid>

                        <!-- 状态文本标签 -->
                        <TextBlock x:Name="LabelText"
                                   Text="{TemplateBinding Label}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <!-- 无文本时自动折叠右侧间距 -->
                        <Trigger Property="Label" Value="">
                            <Setter TargetName="LabelText" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!-- 状态 1：Offline (离线) -->
                        <Trigger Property="State" Value="Offline">
                            <Setter TargetName="CoreDot" Property="Fill" Value="#6B7280" />
                            <Setter TargetName="GlowRing" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!-- 状态 2：Idle (就绪 - 科技蓝) -->
                        <Trigger Property="State" Value="Idle">
                            <Setter TargetName="CoreDot" Property="Fill" Value="#3B82F6" />
                            <Setter TargetName="GlowRing" Property="Fill" Value="#3B82F6" />
                            <Setter TargetName="GlowRing" Property="Opacity" Value="0.45" />
                        </Trigger>

                        <!-- 状态 3：Running (运行中 - 翡翠绿) -->
                        <Trigger Property="State" Value="Running">
                            <Setter TargetName="CoreDot" Property="Fill" Value="#10B981" />
                            <Setter TargetName="GlowRing" Property="Fill" Value="#10B981" />
                            <Setter TargetName="GlowRing" Property="Opacity" Value="0.55" />
                        </Trigger>

                        <!-- 状态 4：Warning (警告 - 琥珀橙 + 慢速呼吸) -->
                        <Trigger Property="State" Value="Warning">
                            <Setter TargetName="CoreDot" Property="Fill" Value="#F59E0B" />
                            <Setter TargetName="GlowRing" Property="Fill" Value="#F59E0B" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="WarningBlink">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="CoreDot" Storyboard.TargetProperty="Opacity" From="1.0" To="0.35" Duration="0:0:0.7" />
                                        <DoubleAnimation Storyboard.TargetName="GlowRing" Storyboard.TargetProperty="Opacity" From="0.65" To="0.1" Duration="0:0:0.7" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="WarningBlink" />
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- 状态 5：Error (故障报警 - 警示红 + 高频闪烁) -->
                        <Trigger Property="State" Value="Error">
                            <Setter TargetName="CoreDot" Property="Fill" Value="#EF4444" />
                            <Setter TargetName="GlowRing" Property="Fill" Value="#EF4444" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ErrorBlink">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="CoreDot" Storyboard.TargetProperty="Opacity" From="1.0" To="0.2" Duration="0:0:0.3" />
                                        <DoubleAnimation Storyboard.TargetName="GlowRing" Storyboard.TargetProperty="Opacity" From="0.85" To="0.1" Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="ErrorBlink" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== -->
    <!-- 自定义现代拨动开关样式 (AyuToggleSwitch)                               -->
    <!-- ===================================================================== -->
    <Style TargetType="{x:Type local:AyuToggleSwitch}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:AyuToggleSwitch}">
                    <Grid>
                        <!-- 胶囊轨道背景 -->
                        <Border x:Name="Track"
                                Background="{TemplateBinding UncheckedBackground}"
                                BorderBrush="#3E4352"
                                BorderThickness="1"
                                CornerRadius="12">
                            <Grid>
                                <!-- 开启状态内嵌文字 (左侧) -->
                                <TextBlock x:Name="OnLabel"
                                           Text="{TemplateBinding OnText}"
                                           Foreground="White"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           Margin="7,0,0,0"
                                           Opacity="0" />

                                <!-- 关闭状态内嵌文字 (右侧) -->
                                <TextBlock x:Name="OffLabel"
                                           Text="{TemplateBinding OffText}"
                                           Foreground="#9CA3AF"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,7,0"
                                           Opacity="1" />
                            </Grid>
                        </Border>

                        <!-- 白色圆形滑块（带平滑位移动画与微投影） -->
                        <Border x:Name="Thumb"
                                Width="18"
                                Height="18"
                                CornerRadius="9"
                                Background="#FFFFFF"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="3,0,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" Direction="270" ShadowDepth="1" Color="#000000" Opacity="0.35" />
                            </Border.Effect>
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ThumbTranslate" X="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- 选中 (开启) 状态动画 -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{Binding CheckedBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="Transparent" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!-- 滑块向右平滑移动 22px (46 - 18 - 3*2 = 22) -->
                                        <DoubleAnimation Storyboard.TargetName="ThumbTranslate" Storyboard.TargetProperty="X" To="22" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="OnLabel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="OffLabel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTranslate" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="OnLabel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="OffLabel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- 鼠标悬停微亮反馈 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Thumb" Property="Background" Value="#F9FAFB" />
                        </Trigger>

                        <!-- 禁用状态 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- 基础标题栏按钮 -->
    <Style x:Key="TitleBarBtn" TargetType="Button">
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#CCCCCC" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2D2D30" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 关闭按钮 -->
    <Style x:Key="CloseWinBtn" BasedOn="{StaticResource TitleBarBtn}" TargetType="Button">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E81123" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 通用：右侧功能工具组（设置、主题、帮助、中英文） -->
    <ControlTemplate x:Key="CommonToolsTemplate" TargetType="Control">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- 设置 -->
            <Button Style="{StaticResource TitleBarBtn}" Command="{Binding SettingsCommand, RelativeSource={RelativeSource AncestorType=local:CustomWindow}}" ToolTip="设置">
