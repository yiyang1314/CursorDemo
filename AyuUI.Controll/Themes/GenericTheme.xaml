    <!-- 通用：窗口控制按钮组（最小化、最大化/还原、关闭） -->
    <ControlTemplate x:Key="SystemWindowButtonsTemplate" TargetType="Control">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource TitleBarBtn}" Width="38" Height="42" Command="{x:Static SystemCommands.MinimizeWindowCommand}" ToolTip="最小化">
                <Path Data="M0,0 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="10" Height="1" />
            </Button>
            <Button x:Name="MaxBtn" Style="{StaticResource TitleBarBtn}" Width="38" Height="42" Command="{x:Static SystemCommands.MaximizeWindowCommand}" ToolTip="最大化">
                <Path x:Name="MaxIcon" Data="M0,0 L10,0 L10,10 L0,10 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="10" Height="10" />
            </Button>
            <Button Style="{StaticResource CloseWinBtn}" Command="{x:Static SystemCommands.CloseWindowCommand}" ToolTip="关闭">
                <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="10" Height="10" />
            </Button>
        </StackPanel>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                <Setter TargetName="MaxBtn" Property="Command" Value="{x:Static SystemCommands.RestoreWindowCommand}" />
                <Setter TargetName="MaxIcon" Property="Data" Value="M2,0 L10,0 L10,8 M0,2 L8,2 L8,10 L0,10 Z" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 通用搜索输入框样式（用于风格4） -->
    <Style x:Key="PortalSearchBoxStyle" TargetType="TextBox">
        <Setter Property="Width" Value="180" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Background" Value="#25282C" />
        <Setter Property="Foreground" Value="#E5E7EB" />
        <Setter Property="BorderBrush" Value="#3E4249" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="28,0,8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <Grid>
                            <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                  Fill="#8E929B" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Left" Margin="9,0,0,0" />
                            <TextBlock x:Name="Placeholder" Text="Search" Foreground="#8E929B" VerticalAlignment="Center" Margin="28,0,0,0" IsHitTestVisible="False" Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="26,0,6,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CustomWindow 主样式 -->
    <Style TargetType="{x:Type local:CustomWindow}">
        <Setter Property="Background" Value="#18191C" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="42" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CustomWindow}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="#2D2F36" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- ============================================================== -->
                            <!-- 风格 1：ModernTool (原图：图标+粗体标题 + 右侧功能工具)            -->
                            <!-- ============================================================== -->
                            <Border x:Name="Bar_ModernTool" Grid.Row="0" Background="#12131C" BorderBrush="#1F212E" BorderThickness="0,0,0,1" Visibility="Visible">
                                <Grid Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="24" Height="24" CornerRadius="6" Margin="0,0,10,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#7C83FD" Offset="0" />
                                                    <GradientStop Color="#565CEB" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Path Data="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z" Fill="White" Width="13" Height="13" Stretch="Uniform" />
                                        </Border>
                                        <TextBlock Text="{TemplateBinding Title}" FontSize="14" FontWeight="Bold" Foreground="#F3F4F6" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Control Template="{StaticResource CommonToolsTemplate}" />
                                        <Border Width="1" Height="16" Background="#2E3244" Margin="6,0" />
                                        <Control Template="{StaticResource SystemWindowButtonsTemplate}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ============================================================== -->
                            <!-- 风格 2：VisualStudio (图1：紫Logo + 菜单栏 + 搜索 + 项目徽章 + 头像) -->
                            <!-- ============================================================== -->
                            <Border x:Name="Bar_VisualStudio" Grid.Row="0" Background="#1F1F1F" BorderBrush="#2D2D30" BorderThickness="0,0,0,1" Visibility="Collapsed">
                                <Grid Margin="10,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 左侧：VS 紫图标 + 菜单插槽 + 搜索按钮 -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M17.5,2L9,10.5L4.5,7L2,8.5V15.5L4.5,17L9,13.5L17.5,22L22,20V4L17.5,2M17.5,16.5L12,12L17.5,7.5V16.5Z"
                                              Fill="#9A77F5" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" />
                                        <ContentPresenter Content="{TemplateBinding TitleBarMenuContent}" WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource TitleBarBtn}" Command="{TemplateBinding SearchCommand}" Margin="6,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                                      Fill="#CCCCCC" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" />
                                                <TextBlock Text="搜索 ⌄" FontSize="12" Foreground="#CCCCCC" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- 右侧：项目胶囊徽章 + 头像 + 通用工具 + 系统控制 -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- 项目名称胶囊标签 (如 CursorWpf) -->
                                        <Border Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="5" Padding="10,4" Margin="0,0,10,0">
                                            <TextBlock Text="{TemplateBinding ProjectBadgeText}" FontSize="12" FontWeight="SemiBold" Foreground="#E5E5E5" />
                                        </Border>
                                        <!-- 圆形头像 -->
                                        <Border Width="22" Height="22" CornerRadius="11" Background="#4B5563" Margin="0,0,8,0" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="U" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image Source="{TemplateBinding UserAvatar}" Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>
                                        <Control Template="{StaticResource CommonToolsTemplate}" />
                                        <Border Width="1" Height="16" Background="#3E3E42" Margin="4,0" />
                                        <Control Template="{StaticResource SystemWindowButtonsTemplate}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ============================================================== -->
                            <!-- 风格 3：MinimalEditor (图2：侧边栏按钮+搜索图标+竖线+精简菜单)     -->
                            <!-- ============================================================== -->
                            <Border x:Name="Bar_MinimalEditor" Grid.Row="0" Background="#242424" BorderBrush="#303030" BorderThickness="0,0,0,1" Visibility="Collapsed">
                                <Grid Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- 侧边栏切换图标 -->
                                        <Button Style="{StaticResource TitleBarBtn}" Command="{TemplateBinding ToggleSidebarCommand}" ToolTip="切换侧边栏">
                                            <Path Data="M4,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M4,6V18H9V6H4M11,6V18H20V6H11Z"
                                                  Fill="#B0B0B0" Width="15" Height="15" Stretch="Uniform" />
                                        </Button>
                                        <!-- 搜索图标 -->
                                        <Button Style="{StaticResource TitleBarBtn}" Command="{TemplateBinding SearchCommand}" ToolTip="搜索">
                                            <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                                  Fill="#B0B0B0" Width="14" Height="14" Stretch="Uniform" />
                                        </Button>
                                        <!-- 竖线分隔符 -->
                                        <Border Width="1" Height="16" Background="#3C3C3C" Margin="6,0" />
                                        <!-- 精简菜单插槽 -->
                                        <ContentPresenter Content="{TemplateBinding TitleBarMenuContent}" WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Control Template="{StaticResource CommonToolsTemplate}" />
                                        <Border Width="1" Height="16" Background="#3C3C3C" Margin="4,0" />
                                        <Control Template="{StaticResource SystemWindowButtonsTemplate}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ============================================================== -->
                            <!-- 风格 4：ModernPortal (图3：多色块Logo + 导航 + 高亮按钮 + 搜索框) -->
                            <!-- ============================================================== -->
                            <Border x:Name="Bar_ModernPortal" Grid.Row="0" Background="#1D2024" BorderBrush="#2C3036" BorderThickness="0,0,0,1" Visibility="Collapsed">
                                <Grid Margin="14,0,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- 三色渐变竖条组合Logo (还原 WPF UI 图标) -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                            <Border Width="5" Height="16" Background="#38BDF8" CornerRadius="2,0,0,2" />
                                            <Border Width="5" Height="16" Background="#0284C7" />
                                            <Border Width="5" Height="16" Background="#0369A1" CornerRadius="0,2,2,0" />
                                        </StackPanel>
                                        <TextBlock Text="{TemplateBinding Title}" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,16,0" />
                                        <!-- 导航菜单插槽 -->
                                        <ContentPresenter Content="{TemplateBinding TitleBarMenuContent}" WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <!-- 通用工具 (设置、主题、帮助、中英文) -->
                                        <Control Template="{StaticResource CommonToolsTemplate}" />

                                        <!-- 青蓝色高亮按钮 (如 Sponsor) -->
                                        <Button Content="{TemplateBinding HighlightActionText}"
                                                Command="{TemplateBinding HighlightActionCommand}"
                                                Background="#0E7490" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                                Padding="12,5" Margin="8,0" Cursor="Hand"
                                                WindowChrome.IsHitTestVisibleInChrome="True">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#0891B2" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- 嵌入式搜索框 -->
                                        <TextBox Style="{StaticResource PortalSearchBoxStyle}" Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />

                                        <!-- 系统窗口按钮 -->
                                        <Control Template="{StaticResource SystemWindowButtonsTemplate}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 页面主内容区域 -->
                            <ContentPresenter Grid.Row="1" />
                        </Grid>
                    </Border>

                    <!-- 风格切换触发器 -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="StyleMode" Value="VisualStudio">
                            <Setter TargetName="Bar_ModernTool" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Bar_VisualStudio" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="StyleMode" Value="MinimalEditor">
                            <Setter TargetName="Bar_ModernTool" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Bar_MinimalEditor" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="StyleMode" Value="ModernPortal">
                            <Setter TargetName="Bar_ModernTool" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Bar_ModernPortal" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 标题栏通用按钮样式 -->
    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#D1D5DB" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <!-- 关键属性：让标题栏上的按钮可以响应鼠标点击而不是触发窗口拖动 -->
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Margin="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2A2D3D" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#363A4F" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 关闭按钮专属样式（悬浮变红） -->
    <Style x:Key="CloseButtonStyle" BasedOn="{StaticResource TitleBarButtonStyle}" TargetType="Button">
        <Setter Property="Width" Value="42" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E81123" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F1707A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- BaseWindow 完整模板 -->
    <Style TargetType="{x:Type local:BaseWindow}">
        <Setter Property="Background" Value="#14151E" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome
                    CaptionHeight="44"
                    CornerRadius="0"
                    GlassFrameThickness="0"
                    ResizeBorderThickness="6"
                    UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:BaseWindow}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="#262938"
                        BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- 顶部标题栏高度 44px -->
                                <RowDefinition Height="44" />
                                <!-- 窗口主体内容区域 -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 顶部标题栏背景 -->
                            <Border Grid.Row="0" Background="#12131C" BorderBrush="#1F212E" BorderThickness="0,0,0,1">
                                <Grid Margin="12,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 左侧：渐变圆角图标 + 标题 -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- 还原图片中的蓝紫渐变圆角图标 -->
                                        <Border Width="26" Height="26" CornerRadius="6" Margin="0,0,10,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#7C83FD" Offset="0" />
                                                    <GradientStop Color="#565CEB" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <!-- 如果外部传入了 AppIcon 则显示图片，否则显示默认星星矢量图 -->
                                            <Grid>
                                                <Image Source="{TemplateBinding AppIcon}" Margin="3" />
                                                <Path
