<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========================================== -->
  <!-- 0. 多目标框架 + 类库输出                    -->
  <!--    net48 使用 .NET Framework WPF 程序集     -->
  <!--    net6.0 / net8.0 使用 -windows TFM        -->
  <!-- ========================================== -->
  <PropertyGroup>
    <TargetFrameworks>net48;net6.0-windows;net8.0-windows</TargetFrameworks>
    <OutputType>Library</OutputType>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AyuUI.Controll</RootNamespace>
    <AssemblyName>AyuUI.Controll</AssemblyName>
  </PropertyGroup>

  <!-- 仅 net6.0-windows / net8.0-windows 支持声明 Windows 平台最低版本 -->
  <PropertyGroup Condition="'$(TargetFramework)' != 'net48'">
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- ========================================== -->
    <!-- 1. NuGet 基础元数据配置                     -->
    <!-- ========================================== -->
    <PackageId>AyuUI.Controll</PackageId>
    <Version>1.0.0</Version>
    <!-- 每次更新迭代时升级版本号，如 1.0.1 -->
    <Authors>yiyangyu</Authors>
    <Company>AyuStudio</Company>
    <Product>AyuUI Framework</Product>
    <Description>一套高颜值、零依赖、支持注解IoC、消息总线与丰富UI控件的现代WPF自研框架。</Description>
    <PackageTags>WPF;UI;MVVM;IOC;AyuUI</PackageTags>

    <!-- ========================================== -->
    <!-- 关键：指定 NuGet 使用的 README 文件         -->
    <!-- ========================================== -->
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- ========================================== -->
    <!-- 2. 自动化打包开关（核心）      dotnet nuget add source "D:\LocalNugetRepository" name "LocalRepo"              -->
    <!-- ========================================== -->
    <!-- 开启后，每次执行 dotnet build 或 release 时会自动在输出目录生成 .nupkg 包 -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

    <!-- 可选：如果希望把生成的 XML 文档注释一起打包进 NuGet（方便其他项目调用时有智能提示） -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- net6.0 已停止支持，仅告警提示并不阻断编译 -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- 可选：开源许可证与图标（若有需要可填写） -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <!-- ========================================== -->
  <!-- 3. 应用入口文件：类库不承担启动职责           -->
  <!--    App.xaml / App.xaml.cs 保留在磁盘，但不参与编译， -->
  <!--    避免 ApplicationDefinition 生成入口与启动项     -->
  <!-- ========================================== -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Remove="App.xaml" />
    <Compile Remove="App.xaml.cs" />
    <None Include="App.xaml" />
  </ItemGroup>

  <!-- ========================================== -->
  <!-- 4. 各目标框架的引用差异                      -->
  <!-- ========================================== -->
  <!-- net48：System.Drawing / System.Configuration 由框架提供；System.Text.Json 需独立包 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Drawing" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <!-- net6.0：System.Drawing.Common 需独立引用；改配置需 ConfigurationManager 包 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0-windows'">
    <PackageReference Include="System.Drawing.Common" Version="6.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="6.0.0" />
  </ItemGroup>

  <!-- net8.0：同上，版本对齐 .NET 8 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="publish\**" />
    <EmbeddedResource Remove="publish\**" />
    <None Remove="publish\**" />
    <Page Remove="publish\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Controls\AyuNavigationMenu.xaml">
      <Generator>MSBuild:Compile</Generator>
    </None>
    <None Update="Pages\AyuMessageWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
    </None>
    <None Update="Pages\AyuToastContainer.xaml">
      <Generator>MSBuild:Compile</Generator>
    </None>
    <None Update="Simples\AyuSimpleWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
    </None>
    <None Update="Themes\GenericTheme.xaml">
      <Generator>MSBuild:Compile</Generator>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Extension\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
