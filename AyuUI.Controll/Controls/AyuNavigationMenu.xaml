<UserControl x:Class="AyuUI.Controll.Controls.AyuNavigationMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AyuUI.Controll.Controls"
             mc:Ignorable="d" 
            x:Name="NavRoot">
    <UserControl.Resources>
        <local:PositionToAlignmentConverter x:Key="PosToAlign" />

        <!-- 单个导航 RadioButton 样式 -->
        <Style x:Key="NavigationRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ItemBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="4,2"
                                Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 矢量图标 -->
                                <Path x:Name="Icon"
                                      Width="16" Height="16"
                                      Stretch="Uniform"
                                      Fill="{TemplateBinding Foreground}"
                                      Data="{Binding IconData}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0" />

                                <!-- 菜单标题文本 -->
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Content"
                                                  VerticalAlignment="Center" />

                                <!-- 绿色高亮指示条（根据 Position 自动停靠：Left=右侧，Top=底部，Bottom=顶部） -->
                                <Border x:Name="Indicator"
                                        Background="#10B981"
                                        CornerRadius="1.5"
                                        Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 鼠标悬停高亮 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="#252832" />
                                <Setter Property="Foreground" Value="#F3F4F6" />
                            </Trigger>

                            <!-- 选中高亮状态 -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="#1F2937" />
                                <Setter TargetName="ItemBd" Property="BorderBrush" Value="#374151" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="Icon" Property="Fill" Value="#10B981" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            </Trigger>

                            <!-- 动态绑定指示条的宽度、高度与停靠位置 -->
                            <DataTrigger Binding="{Binding Position, ElementName=NavRoot}" Value="Left">
                                <Setter TargetName="Indicator" Property="Width" Value="3" />
                                <Setter TargetName="Indicator" Property="Height" Value="18" />
                                <Setter TargetName="Indicator" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Indicator" Property="VerticalAlignment" Value="Center" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding Position, ElementName=NavRoot}" Value="Top">
                                <Setter TargetName="Indicator" Property="Height" Value="3" />
                                <Setter TargetName="Indicator" Property="VerticalAlignment" Value="Bottom" />
                                <Setter TargetName="Indicator" Property="Margin" Value="-12,0,-12,-8" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding Position, ElementName=NavRoot}" Value="Bottom">
                                <Setter TargetName="Indicator" Property="Height" Value="3" />
                                <Setter TargetName="Indicator" Property="VerticalAlignment" Value="Top" />
                                <Setter TargetName="Indicator" Property="Margin" Value="-12,-8,-12,0" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 外部容器背景 -->
    <Border Background="#181A1F" Padding="6">
        <ItemsControl x:Name="MenuItemsControl" ItemsSource="{Binding ItemsSource, ElementName=NavRoot}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel x:Name="PanelOrientation" Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton Style="{StaticResource NavigationRadioButtonStyle}"
                                 Content="{Binding Title}"
                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                 GroupName="{Binding ElementName=NavRoot, Path=GroupName}"
                                 Checked="RadioButton_Checked" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>
