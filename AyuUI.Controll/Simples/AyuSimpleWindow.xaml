<controls:CustomWindow x:Class="AyuUI.Controll.Simples.AyuSimpleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AyuUI.Controll.Simples"
        mc:Ignorable="d"
        xmlns:controls="clr-namespace:AyuUI.Controll.Controls"
        x:Name="RootWin"
        Title="WPF UI"
        Width="1150"
        Height="700"
        StyleMode="VisualStudio"
        ProjectBadgeText="CursorWpf"
        HighlightActionText="Sponsor"
        LanguageText="{Binding CurrentLangText}"
        SettingsCommand="{Binding OpenSettingsCommand}"
        ToggleThemeCommand="{Binding ToggleThemeCommand}"
        HelpCommand="{Binding OpenHelpCommand}"
        ToggleLanguageCommand="{Binding SwitchLanguageCommand}">

    <!-- 传入顶部菜单栏 (适用于 VisualStudio / MinimalEditor / ModernPortal 风格) -->
    <controls:CustomWindow.TitleBarMenuContent>
        <!-- KeycapDarkMenuStyle VsDarkMenuStyle-->
        <Menu Style="{StaticResource KeycapDarkMenuStyle}" VerticalAlignment="Center">
            <MenuItem Header="文件(F)">
                <!-- 支持嵌套二级/三级子菜单，会自动出现右侧 > 箭头 -->
                <MenuItem Header="新建(N)">
                    <MenuItem Header="项目(P)..." InputGestureText="Ctrl+Shift+N" />
                    <MenuItem Header="文件(F)..." InputGestureText="Ctrl+N" />
                </MenuItem>
                <MenuItem Header="打开(O)">
                    <MenuItem Header="项目/解决方案(P)..." InputGestureText="Ctrl+Shift+O" />
                    <MenuItem Header="文件(F)..." InputGestureText="Ctrl+O" />
                </MenuItem>
                <Separator />
                <!-- 支持左侧传入矢量图标 -->
                <MenuItem Header="保存 AyuSimpleWindow.xaml (S)" InputGestureText="Ctrl+S">
                    <MenuItem.Icon>
                        <Path Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z"
                          Fill="#38BDF8" Stretch="Uniform" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="全部保存(L)" InputGestureText="Ctrl+Shift+S">
                    <MenuItem.Icon>
                        <Path Data="M17,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M15,9H5V5H15V9Z"
                          Fill="#38BDF8" Stretch="Uniform" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="退出(X)" InputGestureText="Alt+F4" />
            </MenuItem>
            <MenuItem Header="文件(F)" >
                <MenuItem Header="打开" InputGestureText="ctrl + O"/>
                <MenuItem Header="新建" InputGestureText="ctrl + N"/>
                <MenuItem Header="保存" InputGestureText="ctrl + S"/>
                <MenuItem Header="另存为" InputGestureText="ctrl + ALT + S"/>
                <MenuItem Header="退出" InputGestureText="ctrl + E"/>
            </MenuItem>
            <MenuItem Header="编辑(E)">
                <MenuItem Header="撤消" InputGestureText="Ctrl+Z" />
                <MenuItem Header="恢复" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="剪切" InputGestureText="Ctrl+X" />
                <MenuItem Header="复制" InputGestureText="Ctrl+C" />
                <MenuItem Header="粘贴" InputGestureText="Ctrl+V" />
            </MenuItem>
            <MenuItem Header="视图(V)" />
            <MenuItem Header="Git(G)" />
            <MenuItem Header="项目(P)" />
            <MenuItem Header="帮助(H)" />
        </Menu>
    </controls:CustomWindow.TitleBarMenuContent>

    <!-- 主内容区域：放置 4 个按钮测试运行时一键换肤/换布局 -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="点击下方按钮实时预览 4 种 Windows 标题栏风格" Foreground="White" FontSize="16" Margin="0,0,0,20" HorizontalAlignment="Center" />
        <StackPanel Orientation="Horizontal">
            <Button Content="风格1: ModernTool" Click="SwitchStyle_Click" Tag="ModernTool" Padding="14,8" Margin="6" />
            <Button Content="风格2: VisualStudio" Click="SwitchStyle_Click" Tag="VisualStudio" Padding="14,8" Margin="6" />
            <Button Content="风格3: MinimalEditor" Click="SwitchStyle_Click" Tag="MinimalEditor" Padding="14,8" Margin="6" />
            <Button Content="风格4: ModernPortal" Click="SwitchStyle_Click" Tag="ModernPortal" Padding="14,8" Margin="6" />
        </StackPanel>
    </StackPanel>

</controls:CustomWindow>
