<Window x:Class="AyuUI.Controll.Pages.AyuMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AyuUI.Controll.Pages"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- 主行动按钮样式 -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#3B82F6" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要/取消按钮样式 -->
        <Style x:Key="SecondaryBtnStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#2A2D37" />
            <Setter Property="Foreground" Value="#D1D5DB" />
            <Setter Property="BorderBrush" Value="#3B3F4E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#353946" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代圆角输入框样式 -->
        <Style x:Key="ModernInputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="#14161B" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="CaretBrush" Value="#60A5FA" />
            <Setter Property="BorderBrush" Value="#323644" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <Grid>
                                <TextBlock x:Name="PlaceholderText" Text="{TemplateBinding Tag}" Foreground="#6B7280" FontSize="13" VerticalAlignment="Center" Margin="13,0" IsHitTestVisible="False" Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" Margin="10,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6" />
                            </Trigger>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外层透明留白，防止投影被裁剪 -->
    <Grid Margin="18">
        <!-- ================================================================ -->
        <!-- 模式 1：常规消息卡片 (Info / Error / Confirm / Input)             -->
        <!-- ================================================================ -->
        <Border x:Name="StandardCard" MinWidth="380" MaxWidth="480" Background="#1E2026" BorderBrush="#303440" BorderThickness="1" CornerRadius="12" Padding="24,22" MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" Direction="270" ShadowDepth="6" Color="#000000" Opacity="0.55" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 顶部：徽标图标 + 标题 + 右上角关闭小叉 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 状态圆形光晕徽标 -->
                    <Border x:Name="IconBadge" Width="38" Height="38" CornerRadius="19" Background="#1E3A8A" Margin="0,0,14,0" VerticalAlignment="Top">
                        <Path x:Name="IconPath" Width="18" Height="18" Stretch="Uniform" Fill="#60A5FA"
                              Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z" />
                    </Border>

                    <!-- 标题与正文内容 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="提示" FontSize="15.5" FontWeight="Bold" Foreground="#F9FAFB" TextWrapping="Wrap" />
                        <TextBlock x:Name="MessageText" Text="这是一条提示消息内容。" FontSize="13.5" Foreground="#B4B9C4" LineHeight="21" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- 右上角轻量关闭按钮 -->
                    <Button Grid.Column="2" Width="26" Height="26" Background="Transparent" BorderThickness="0" Foreground="#6B7280" Cursor="Hand" VerticalAlignment="Top" Click="CancelBtn_Click" Margin="8,-4,-6,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CloseBd" Background="Transparent" CornerRadius="5">
                                    <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" Width="9" Height="9" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseBd" Property="Background" Value="#2D313D" />
                                        <Setter Property="Foreground" Value="#F3F4F6" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- 中部：Input 模式下显示的圆角文本框 -->
                <TextBox x:Name="InputBox" Grid.Row="1" Style="{StaticResource ModernInputBoxStyle}" Margin="52,16,0,0" Visibility="Collapsed" KeyDown="InputBox_KeyDown" />

                <!-- 底部：操作按钮组 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource SecondaryBtnStyle}" Margin="0,0,10,0" Click="CancelBtn_Click" Visibility="Collapsed" />
                    <Button x:Name="ConfirmBtn" Content="确定" Style="{StaticResource PrimaryBtnStyle}" Click="ConfirmBtn_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================================ -->
        <!-- 模式 2：Loading 加载卡片 (居中紧凑型 + 流畅旋转渐变圆环)           -->
        <!-- ================================================================ -->
        <Border x:Name="LoadingCard" MinWidth="220" MaxWidth="340" Background="#1E2026" BorderBrush="#303440" BorderThickness="1" CornerRadius="14" Padding="28,24" Visibility="Collapsed" MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" Direction="270" ShadowDepth="6" Color="#000000" Opacity="0.6" />
            </Border.Effect>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- 旋转加载圆环 -->
                <Grid Width="42" Height="42" Margin="0,0,0,16">
                    <!-- 背景暗环 -->
                    <Ellipse Stroke="#2E3342" StrokeThickness="3.5" />
                    <!-- 旋转高亮弧 -->
                    <Path Stroke="#3B82F6" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 21,2 A 19,19 0 0 1 40,21" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" Angle="0" />
                        </Path.RenderTransform>
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SpinnerRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.9" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>
                </Grid>

                <TextBlock x:Name="LoadingText" Text="正在处理中，请稍候..." FontSize="13.5" FontWeight="Medium" Foreground="#E5E7EB" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
