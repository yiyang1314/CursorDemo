<Window x:Class="AyuUI.Controll.Pages.AyuToastContainer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AyuUI.Controll.Pages"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <!-- 单个 Toast 卡片动画样式 -->
        <Style x:Key="ToastCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E2026" />
            <Setter Property="BorderBrush" Value="#303440" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="MaxWidth" Value="360" />
            <Setter Property="MinWidth" Value="260" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Color="#000000" Opacity="0.45" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 主容器：根据传入的 Position 自动对齐排列 -->
    <Grid x:Name="RootLayout" Margin="16">
        <StackPanel x:Name="ToastStack" VerticalAlignment="Bottom" HorizontalAlignment="Right">
            <ItemsControl x:Name="ToastItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ToastCardStyle}" MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave" MouseLeftButtonDown="Card_MouseLeftButtonDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 状态图标 -->
                                <Border x:Name="IconBadge" Width="30" Height="30" CornerRadius="15" Background="#172554" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Path x:Name="IconPath" Width="14" Height="14" Stretch="Uniform" Fill="#60A5FA" Data="{Binding IconData}" />
                                </Border>

                                <!-- 文本内容 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold" Foreground="#F3F4F6" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Message}" FontSize="12.5" Foreground="#9CA3AF" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- 超过3个堆叠时的总数聚合徽标或关闭叉 -->
                                <Border Grid.Column="2" x:Name="BadgeCount" Background="#374151" CornerRadius="8" Padding="6,2" VerticalAlignment="Top" Margin="8,-4,-4,0" Visibility="{Binding BadgeVisibility}">
                                    <TextBlock Text="{Binding TotalCountText}" FontSize="10.5" FontWeight="Bold" Foreground="#F9FAFB" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</Window>
