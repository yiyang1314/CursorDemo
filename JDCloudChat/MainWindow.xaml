<control:CustomWindow x:Class="JDCloudChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JDCloudChat"
        xmlns:control="clr-namespace:AyuUI.Controll.Controls;assembly=AyuUI.Controll"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors" 
        xmlns:md="clr-namespace:MdXaml;assembly=MdXaml"
        mc:Ignorable="d"
        StyleMode="MinimalEditor"
        WindowStartupLocation="CenterScreen"
        Title="Gemini AI 桌面助手" Height="880" Width="1200"
        Background="#F0F4F9" 
        ToggleSidebarCommand ="{Binding ToggleThemeCommand}">
    <control:CustomWindow.Resources>

        <!-- 之前定义的头像转换器 -->
        <local:UserToAvatarConverter x:Key="UserToAvatarConverter"/>
        <!-- 1. 重写下拉列表项 (ComboBoxItem) 的样式 -->
        <Style x:Key="ModernComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" 
                            Background="{TemplateBinding Background}" 
                            Padding="{TemplateBinding Padding}" 
                            CornerRadius="4" 
                            Margin="4,2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 悬停效果 -->
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <!-- 选中效果 -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E7FF"/>
                                <Setter Property="Foreground" Value="#4338CA"/>
                            </Trigger>
                            <!-- 禁用效果 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 2. 重写 ComboBox 本身的样式 -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- 主体背景框 -->
                            <Border x:Name="MainBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="32"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 显示当前选中的内容 -->
                                    <ContentPresenter x:Name="ContentSite"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"/>

                                    <!-- 右侧下拉箭头 (使用 Path 绘制一个现代感的小箭头) -->
                                    <Path x:Name="Arrow" 
                                      Grid.Column="1"
                                      Data="M 0 0 L 5 5 L 10 0" 
                                      Stroke="#6B7280" 
                                      StrokeThickness="1.5" 
                                      VerticalAlignment="Center" 
                                      HorizontalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </Path.RenderTransform>
                                    </Path>

                                    <!-- 透明 ToggleButton 用于处理点击事件和交互状态 -->
                                    <ToggleButton x:Name="ToggleButton" 
                                              Grid.ColumnSpan="2"
                                              Focusable="False" 
                                              ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <!-- 下拉弹出层 -->
                            <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" 
                               Focusable="False" 
                               PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" 
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}" 
                                  Margin="0,4,0,0">
                                    <!-- 弹出层阴影 -->
                                    <Border x:Name="DropDownBorder" 
                                        Background="White" 
                                        BorderBrush="#E5E7EB" 
                                        BorderThickness="1" 
                                        CornerRadius="6">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
                                        </Border.Effect>
                                        <!-- 下拉列表 -->
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>

                        <!-- 交互状态控制 -->
                        <ControlTemplate.Triggers>
                            <!-- 鼠标悬停 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#9CA3AF"/>
                                <Setter TargetName="Arrow" Property="Stroke" Value="#374151"/>
                            </Trigger>

                            <!-- 获得焦点/下拉展开 -->
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#4F46E5"/>
                                <Setter TargetName="MainBorder" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Arrow" Property="Stroke" Value="#4F46E5"/>
                                <!-- 箭头翻转动画 -->
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <!-- 禁用状态 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="MainBorder" Property="Background" Value="#F3F4F6"/>
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#E5E7EB"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                <Setter TargetName="Arrow" Property="Stroke" Value="#D1D5DB"/>
                            </Trigger>

                            <!-- 无数据时隐藏下拉 -->
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </control:CustomWindow.Resources>
    <control:CustomWindow.TitleBarMenuContent>
        <Menu Style="{StaticResource KeycapDarkMenuStyle}" VerticalAlignment="Center">
            <MenuItem Header="文件(F)" >
                <MenuItem Header="新建(N)" />
                <MenuItem Header="保存(G)" />
                <MenuItem Header="另存为(P)" />
                <MenuItem Header="撤销(H)" />
            </MenuItem>
            <MenuItem Header="视图(V)" />
            <MenuItem Header="Git(G)" />
            <MenuItem Header="项目(P)" />
            <MenuItem Header="帮助(H)" >
                <MenuItem Header="注册(N)" />
                <MenuItem Header="文档(G)" />
                <MenuItem Header="关于(P)" />
            </MenuItem>
        </Menu>
    </control:CustomWindow.TitleBarMenuContent>
    <Grid Background="LightGray">
        <!--<Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>


        <Border Grid.Column="0" Visibility="{Binding SideVisibied}">
            <control:AyuNavigationMenu  Width="200" 
                           ItemsSource="{Binding MenuItems}"
                           SelectedItem="{Binding SelectedMenuItem}"
                           Position="Left" />
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部标题栏 -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="当前模型： " FontSize="22" FontWeight="Bold" Foreground="#4285F4"/>
                    <ComboBox ItemsSource="{Binding ModelItems}" SelectedItem="{Binding SelectedModel}" Style="{StaticResource ModernComboBox}"/>
                </StackPanel>
            </Border>

            <!-- 聊天消息列表 -->
            <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                <ItemsControl x:Name="ChatItemsControl" ItemsSource="{Binding MsgItems}">
                    <!-- 关键：强制让列表的每一行在水平方向占满整个 ScrollViewer 宽度 -->
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- 外层容器：控制整行靠左（AI）还是靠右（User） -->
                            <Grid Margin="0,8" HorizontalAlignment="Stretch">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <!-- 聊天卡片主体：头像 + 气泡 -->
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="FlowDirection" Value="LeftToRight"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                    <!-- 用户消息：气泡在左，头像在右 -->
                                                    <Setter Property="FlowDirection" Value="RightToLeft"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <!-- 虚拟头像 -->
                                    <Border Width="38" Height="38" CornerRadius="19" VerticalAlignment="Top" Margin="8,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <!-- AI 头像默认样式 -->
                                                <Setter Property="Background" Value="#2D8CF0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <!-- 用户头像样式 -->
                                                        <Setter Property="Background" Value="#67C23A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <!-- 头像文字：AI 或 Me -->
                                        <TextBlock Text="{Binding IsUser, Converter={StaticResource UserToAvatarConverter}}" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                   Foreground="White" FontWeight="Bold" FontSize="12"/>
                                    </Border>

                                    <!-- 气泡内容框 -->
                                    <Border Padding="12,10" CornerRadius="10" HorizontalAlignment="Left" Width="960">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <!-- AI 气泡：浅灰白背景，左侧 -->
                                                <Setter Property="Background" Value="#F4F6F8"/>
                                                <Setter Property="BorderBrush" Value="#E4E7ED"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <!-- 用户气泡：科技蓝背景，右侧 -->
                                                        <Setter Property="Background" Value="#D9ECFF"/>
                                                        <Setter Property="BorderBrush" Value="#B3D8FF"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <!-- 使用 MdXaml 渲染 Markdown / 代码块 -->
                                        <md:MarkdownScrollViewer Markdown="{Binding Content}" 
                                                                 Background="Transparent"
                                                                 Foreground="Black"
                                                                 HorizontalAlignment="Stretch"
                                                                 HorizontalContentAlignment="Stretch"
                                                                 VerticalScrollBarVisibility="Disabled"
                                                                 HorizontalScrollBarVisibility="Auto"
                                                                 FontSize="14"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <!--<ItemsPanelTemplate>
                        <VirtualizingStackPanel IsVirtualizing="True" 
                                    VirtualizationMode="Standard" 
                                    Orientation="Vertical"/>
                    </ItemsPanelTemplate>-->
                </ItemsControl>
            </ScrollViewer>

            <!-- 底部输入区域 -->
            <Border Grid.Row="2" Background="White" CornerRadius="26" Margin="40,10,40,24" Padding="16,8" BorderBrush="#DFE1E5" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputTextBox" Grid.Column="0" BorderThickness="0" Background="Transparent" 
                         FontSize="15" VerticalContentAlignment="Center" AcceptsReturn="True" MaxHeight="100"
                         Text="{Binding ReqMessage.Content}"
                         TextWrapping="Wrap" KeyDown="InputTextBox_KeyDown"/>
                    <Button x:Name="SendButton" Grid.Column="1" Content="➤" Width="38" Height="38" Margin="8,0,0,0"
                            Cursor="Hand" Background="#1A73E8" Foreground="White" FontSize="16" BorderThickness="0" 
                            Visibility="{Binding IsEnableBtn,Converter={StaticResource BoolToVisibilityConverter},ConverterParameter='Inverse'}"
                            Command="{Binding SendMessageCommand}" CommandParameter="{Binding ReqMessage.Content}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="19"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="StopButton" Grid.Column="1" Content="⏹️" Width="38" Height="38" Margin="8,0,0,0"
                            Cursor="Hand" Background="#1A73E8" Foreground="White" FontSize="16" BorderThickness="0" 
                            Visibility="{Binding IsEnableBtn,Converter={StaticResource BoolToVisibilityConverter}}"
                            Command="{Binding SendMessageCommand}" CommandParameter="{Binding ReqMessage.Content}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="19"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</control:CustomWindow>
